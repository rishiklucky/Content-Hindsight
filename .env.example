# CONTENTHINDSIGHT CONFIGURATION
# Backend Port
PORT=3001
NODE_ENV=development

# Groq API Configuration (Fast LLM Inference)
# Optional: Set your Groq API key. If omitted, built-in intelligent strategist engine runs seamlessly.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Persistent Agent Memory Configuration
# Optional: Provide Hindsight credentials here. If omitted, the embedded resilient memory engine runs.
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io/v1
HINDSIGHT_BANK_ID=content-hindsight-prod

# Frontend API URL
VITE_API_URL=http://localhost:3001/api
